{
  "name": "restaurant-platform",
  "version": "1.0.0",
  "description": "Enterprise-grade multi-restaurant SaaS platform",
  "main": "index.js",
  "scripts": {
    "dev": "firebase emulators:start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "deploy": "npm run deploy:functions && npm run deploy:hosting && npm run deploy:rules",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "seed": "node scripts/seed-data.js",
    "lint": "eslint public/**/*.js functions/src/**/*.ts",
    "format": "prettier --write \"**/*.{js,ts,json,css,html}\""
  },
  "keywords": [
    "restaurant",
    "saas",
    "firebase",
    "multi-tenant"
  ],
  "author": "Restaurant Platform Team",
  "license": "MIT",
  "devDependencies": {
    "@firebase/rules-unit-testing": "^2.0.5",
    "@types/jest": "^29.5.0",
    "eslint": "^8.40.0",
    "firebase-tools": "^12.0.0",
    "jest": "^29.5.0",
    "prettier": "^2.8.8"
  },
  "dependencies": {
    "chart.js": "^4.3.0",
    "firebase": "^10.0.0"
  }
}
