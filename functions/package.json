{
  "name": "restaurant-platform-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for Restaurant Platform",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "engines": {
    "node": "18"
  },
  "dependencies": {
    "firebase-admin": "^11.10.0",
    "firebase-functions": "^4.4.0",
    "pdfkit": "^0.13.0",
    "stripe": "^12.10.0",
    "razorpay": "^2.9.0",
    "nodemailer": "^6.9.3",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/node": "^20.3.0",
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "@types/nodemailer": "^6.4.8",
    "@types/pdfkit": "^0.12.9",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "eslint": "^8.40.0",
    "prettier": "^2.8.8",
    "typescript": "^5.1.0",
    "jest": "^29.5.0",
    "@types/jest": "^29.5.0"
  }
}
